# Target selection
CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y

# FreeRTOS Single Core configuration (ESP32-S0WD / SOLO-1)
CONFIG_FREERTOS_UNICORE=y

# Clock and Flash parameters
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_XTAL_FREQ_40=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Compiler Optimization for Flash Size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Bluetooth LE for Matter Commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Networking & LWIP IPv6 for Matter
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Wi-Fi Buffer Tuning
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Disable debug shell to save binary size
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_PW_RPC=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Ignore Xiaomi factory eFuse MAC CRC mismatch (Coding Scheme 3/4)
CONFIG_ESP_MAC_IGNORE_MAC_CRC_ERROR=y

# Matter Device Identification (Xiaomi Mi LED Desk Lamp 1S)
CONFIG_CHIP_PROJECT_CONFIG="main/include/CHIPProjectConfig.h"
CONFIG_USE_TEST_SERIAL_NUMBER="5448E66AE90F"
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y

# Matter Read Client is left ENABLED (esp-matter SDK headers require it internally)
# Our application code does not use ReadClient directly
